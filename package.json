{
  "name": "retro-computer",
  "productName": "Retro Computer",
  "version": "2.2.1",
  "description": "A retro computer for productivity: a 1990s-style desktop with the Craft apps, your files in an ordinary folder and Claude Code in the Command Prompt. In English, Portuguese and Spanish.",
  "main": "src/principal/main.js",
  "license": "MIT",
  "author": "EduChacon",
  "homepage": "https://github.com/EduChacon/Retro-Computer-for-Productivity",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"testes/*.test.js\"",
    "capturas": "node testes/capturas.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "emulators": "8.5.2",
    "mammoth": "^1.13.0",
    "node-pty": "^1.1.0",
    "pcejs-macplus": "0.2.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.56.1"
  },
  "build": {
    "appId": "io.github.educhacon.retrocomputer",
    "productName": "Retro Computer",
    "artifactName": "Retro-Computer-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "EduChacon",
        "repo": "Retro-Computer-for-Productivity"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "recursos"
    },
    "files": [
      "src/**/*",
      "catalogo/**/*",
      "package.json",
      "LICENSE",
      "ATRIBUICOES.md",
      "!node_modules/pdfjs-dist/{web,types,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/legacy/webpack.mjs",
      "!node_modules/pdfjs-dist/legacy/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs,*.map,*.d.mts}",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.worker.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs,*.map}",
      "!node_modules/emulators/dist/{wdosbox-x*,*.map,*.symbols}",
      "!node_modules/emulators/dist/types/**",
      "!node_modules/pcejs-macplus/{lib/**,*.map}",
      "!node_modules/pdf-lib/{dist,es,src,ts3.4}/**",
      "!node_modules/tesseract.js/{dist,docs}/**",
      "!node_modules/tesseract.js-core/*.wasm.js",
      "!node_modules/tesseract.js-core/*-lstm.{js,wasm}",
      "!node_modules/@tesseract.js-data/*/4.0.0/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "src/principal/mcp-retro.js",
      "src/principal/codex-node.js"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "recursos/icone.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "recursos/icone.png",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Retro Computer",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.item"
            ]
          }
        ]
      },
      "identity": "-",
      "entitlements": "recursos/entitlements.mac.plist",
      "entitlementsInherit": "recursos/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "recursos/icone.png",
      "maintainer": "EduChacon <213981293+EduChacon@users.noreply.github.com>",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "recursos/linux",
          "to": "linux",
          "filter": [
            "**/*",
            "!depois-de-*.sh"
          ]
        }
      ]
    },
    "deb": {
      "afterInstall": "recursos/linux/depois-de-instalar.sh",
      "afterRemove": "recursos/linux/depois-de-remover.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "openbox",
        "x11-xserver-utils",
        "x11-utils"
      ],
      "recommends": [
        "xinput",
        "network-manager",
        "pipewire-pulse | pulseaudio-utils | alsa-utils",
        "pulseaudio-utils",
        "xkbset",
        "dosfstools",
        "exfatprogs",
        "flatpak",
        "lxpolkit",
        "wmctrl",
        "xdotool",
        "udisks2",
        "bluez",
        "cups",
        "gnome-keyring",
        "ufw"
      ]
    }
  },
  "desktopName": "retro-computer.desktop"
}
